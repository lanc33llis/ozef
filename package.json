{
  "name": "ozef",
  "description": "opinionated zod empowered forms",
  "version": "0.3.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "packageManager": "bun@1.2.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/lanc33llis/ozef"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf node_modules",
    "clean:build": "git clean -xdf dist lib",
    "build": "bun run clean:build && rollup --config ./configs/rollup.config.mjs",
    "dev": "bun run build",
    "test": "jest",
    "prepublishOnly": "bun run test && bunx tsc --noEmit && bun run build && npm pack --dry-run"
  },
  "peerDependencies": {
    "@types/react": "^19.2.0",
    "jotai": "^2.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/jest": "^29.5.14",
    "@types/node": "24.3.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-jest": "^29.7.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.37.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react-test-renderer": "^19.0.0",
    "rollup": "^4.48.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vite": "^6.2.0",
    "zod": "^4.0.0"
  },
  "type": "module"
}
